{
  "name": "fluxtoflux",
  "version": "0.1.0",
  "description": "Bridge channels between Fluxer instances (e.g. fluxer.app and a self-hosted one)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js --check",
    "backfill": "node src/index.js --backfill",
    "test": "node --test \"test/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" \"test/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "ws": "^8.18.0"
  }
}
